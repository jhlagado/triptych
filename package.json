{
  "name": "triptych",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A modular three-ESP32 computer with Z80-compatible CPU, video, and sound contracts",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cpu": {
      "types": "./dist/cpu/index.d.ts",
      "import": "./dist/cpu/index.js"
    },
    "./sound": {
      "types": "./dist/sound/index.d.ts",
      "import": "./dist/sound/index.js"
    },
    "./video": {
      "types": "./dist/video/index.d.ts",
      "import": "./dist/video/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "roms",
    "system",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "build:wasm-host": "node tools/build-wasm-host.mjs",
    "build:wasm-host:conformance": "node tools/build-wasm-host.mjs --conformance",
    "build:wasm-browser": "node tools/build-wasm-host.mjs --browser",
    "build:cpu-firmware": "node tools/build-cpu-firmware.mjs",
    "generate:cpu-fixtures": "node tools/generate-embedded-cpu-fixtures.mjs",
    "check:cpu-fixtures": "node tools/generate-embedded-cpu-fixtures.mjs --check",
    "check:bdos-baseline": "node tools/check-bdos-baseline.mjs",
    "check:atom-install": "node tools/check-atom-install.mjs",
    "check:ccp-matrix": "node tools/check-ccp-matrix.mjs",
    "check:ccp-readiness": "node --test tools/check-ccp-readiness.test.mjs",
    "check:cpm22-text": "node tools/check-cpm22-text.mjs",
    "normalize:cpm22-text": "node tools/normalize-cpm22-text.mjs",
    "check:cpm-headless": "node tools/check-cpm-headless-scenario.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src test --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.{ts,mjs}\" \"tools/**/*.mjs\" \"crates/**/web/**/*.{js,css,html}\" \"docs/**/*.md\" \"firmware/**/*.md\" README.md AGENTS.md NOTICE.md",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.{ts,mjs}\" \"tools/**/*.mjs\" \"crates/**/web/**/*.{js,css,html}\" \"docs/**/*.md\" \"firmware/**/*.md\" README.md AGENTS.md NOTICE.md",
    "test": "vitest run",
    "test:cpu-conformance": "vitest run test/cpu/conformance.test.ts",
    "check:wasm-browser-ui": "node --check crates/triptych-host-wasm/web/app.js && node --check crates/triptych-host-wasm/web/terminal.js && node --check tools/build-wasm-host.mjs && node --check tools/serve-wasm-browser.mjs && node tools/check-wasm-browser-ui.mjs",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --all-features -- -D warnings && cargo test --workspace --all-features && cargo build -p triptych-host-wasm --target wasm32-unknown-unknown --release",
    "proof:cpm22": "npm run build && node tools/prove-cpm22.mjs",
    "proof:cpm22-native": "cargo build -p triptych-host-native && node tools/prove-cpm22-native.mjs",
    "proof:cpm-image-native": "cargo build -p triptych-cpm-image -p triptych-host-native && node tools/prove-cpm-image-native.mjs",
    "run:cpm22-native": "cargo build -p triptych-host-native && node tools/run-cpm22-native.mjs",
    "run:ccp-native": "TRIPTYCH_CPM22_IMAGE=third_party/cpm22/cpm22.img TRIPTYCH_CPM_CCP=triptych npm run run:cpm22-native",
    "run:wasm-browser": "npm run build:wasm-browser && node tools/serve-wasm-browser.mjs",
    "proof:cpm-headless": "npm run build:wasm-host && node tools/prove-wasm-host.mjs --cpm-headless-only",
    "proof:wasm-host": "npm run build:wasm-host:conformance && node tools/prove-wasm-host.mjs",
    "check": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm run check:ccp-readiness && npm test && npm run check:cpu-fixtures && npm run check:bdos-baseline && npm run check:ccp-matrix && npm run check:cpm22-text && npm run check:cpm-headless && npm run check:wasm-browser-ui && npm run check:rust"
  },
  "devDependencies": {
    "@jhlagado/debug80-runtime": "^0.2.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "atom-z80": "git+https://github.com/jhlagado/atom.git#802b5c2d320bec777f427755ff2d7338e3b80a05",
    "eslint": "^8.55.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
