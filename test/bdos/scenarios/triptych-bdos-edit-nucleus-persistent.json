            "cursorRow": 0,
            "cursorColumn": 0,
            "currentAttributes": 0,
            "wrapPending": false,
            "bellCount": 0,
            "screenSha256": "a85a1067555078d1ee67714cd977f51bec32578cf6abe9ab657d1c3d2821667d"
          }
        },
        {
          "id": "quit-editor",
          "inputBytes": [17],
          "stopAfterAscii": "\r\nA>"
        },
        {
          "id": "run-persisted-program",
