{
  "schema": "triptych-cpm-headless-scenario-v1",
  "id": "triptych-bdos-edit-nucleus-persistent",
  "description": "Edit and save a Nucleus program, compile and run it, then reopen the source and rerun the generated COM file in a fresh machine",
  "systemCcp": "triptych",
  "systemBdos": "triptych",
  "expectedInitialDriveSha256": "a153918c0a6804e3448e76e8d83360bdecab4ccfe445416038b63a68385c11cc",
  "maximumSlices": 1000,
  "sessions": [
    {
      "id": "edit-compile-run",
      "interactions": [
        {
          "id": "boot",
          "inputAscii": "",
          "stopAfterAscii": "\r\nA>"
        },
        {
          "id": "launch-editor",
          "inputAscii": "EDIT INPUT.NU\r",
          "stopAfterAscii": "\u001b[1;1H"
        },
        {
          "id": "find-literal",
          "inputBytes": [6, 39, 79, 39, 13],
          "stopAfterAscii": "\u001b[2;21H"
        },
        {
          "id": "replace-literal",
          "inputBytes": [18, 39, 89, 39, 13],
          "stopAfterAscii": "\u001b[2;21H"
        },
        {
          "id": "save",
          "inputBytes": [19],
          "stopAfterAscii": "\u001b[2;21H"
        },
        {
          "id": "quit",
          "inputBytes": [17],
          "stopAfterAscii": "\r\nA>"
        },
        {
          "id": "compile",
          "inputAscii": "NUC INPUT.NU\r",
          "stopAfterAscii": "\r\nA>"
        },
        {
          "id": "run",
          "inputAscii": "INPUT\r",
          "stopAfterAscii": "YK\r\nA>"
        }
      ],
      "expectedTranscriptSha256": "56fb4ddddb506b22b3b187c1e4692c68c053c8176ba9fc8e7273765ce337894f",
