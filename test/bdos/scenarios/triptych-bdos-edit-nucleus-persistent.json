        {
          "id": "boot",
          "inputAscii": "",
          "stopAfterAscii": "\r\nA>"
        },
        {
          "id": "type-source",
          "inputAscii": "TYPE INPUT.NU\r",
          "stopAfterAscii": "\r\nA>"
        },
        {
